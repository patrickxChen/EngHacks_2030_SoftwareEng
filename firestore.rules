rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasKeys(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthed() && role in request.auth.token.roles;
    }

    function isModeratorOrAdmin() {
      return hasRole('moderator') || hasRole('admin');
    }

    // Users can read their own profile; moderation roles can read all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isModeratorOrAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Myth feed is public to authenticated users.
    match /myths/{mythId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.authorId == request.auth.uid
        && hasKeys(request.resource.data, [
          'text',
          'scopeType',
          'scopeKey',
          'buildingCode',
          'authorId',
          'status',
          'votesUp',
          'votesDown',
          'testimonialCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.buildingCode is string
        && request.resource.data.text is string
        && request.resource.data.scopeType in ['course', 'building']
        && request.resource.data.scopeKey is string
        && request.resource.data.status == 'active'
        && request.resource.data.votesUp == 0
        && request.resource.data.votesDown == 0
        && request.resource.data.testimonialCount == 0;
      allow update: if isAuthed() && (
        (
          resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.scopeType == resource.data.scopeType
          && request.resource.data.scopeKey == resource.data.scopeKey
        ) ||
        isModeratorOrAdmin()
      );
      allow delete: if isModeratorOrAdmin();

      // One vote doc per user.
      match /votes/{userId} {
        allow read: if isAuthed();
        allow create, update: if isOwner(userId)
          && request.resource.data.value in [1, -1];
        allow delete: if isOwner(userId) || isModeratorOrAdmin();
      }

      // Testimonials are user generated and moderated if needed.
      match /testimonials/{testimonialId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.buildingCode is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.text is string;
        allow update: if isAuthed() && (
          resource.data.userId == request.auth.uid ||
          isModeratorOrAdmin()
        );
        allow delete: if isAuthed() && (
          resource.data.userId == request.auth.uid ||
          isModeratorOrAdmin()
        );
      }
    }

    // Aggregates are read-only to clients.
    match /buildingStats/{buildingCode} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // Reports can be created by any authed user and resolved by moderators.
    match /reports/{reportId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isAuthed();
      allow update, delete: if isModeratorOrAdmin();
    }
  }
}
